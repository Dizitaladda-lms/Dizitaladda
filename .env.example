# Next.js runtime database connection. Values are supplied by the deployment environment.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Generate a unique random secret of at least 32 characters for signed login sessions.
AUTH_SECRET=

# Separate MySQL databases used by the legacy blog, affiliate and staff tools.
# These may be omitted when the corresponding features share DB_*.
BLOG_DB_HOST=
BLOG_DB_PORT=3306
BLOG_DB_NAME=
BLOG_DB_USER=
BLOG_DB_PASSWORD=
LEGACY_CONTENT_DB_HOST=
LEGACY_CONTENT_DB_PORT=3306
LEGACY_CONTENT_DB_NAME=
LEGACY_CONTENT_DB_USER=
LEGACY_CONTENT_DB_PASSWORD=
AFFILIATE_DB_HOST=
AFFILIATE_DB_PORT=3306
AFFILIATE_DB_NAME=
AFFILIATE_DB_USER=
AFFILIATE_DB_PASSWORD=
STAFF_DB_HOST=
STAFF_DB_PORT=3306
STAFF_DB_NAME=
STAFF_DB_USER=
STAFF_DB_PASSWORD=
STAFF_SETUP_TOKEN=
MGMT_DB_HOST=
MGMT_DB_PORT=3306
MGMT_DB_NAME=
MGMT_DB_USER=
MGMT_DB_PASSWORD=
SCHOOL_DB_HOST=
SCHOOL_DB_PORT=3306
SCHOOL_DB_NAME=
SCHOOL_DB_USER=
SCHOOL_DB_PASSWORD=
LEADS_DB_HOST=
